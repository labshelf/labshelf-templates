% conference.sty -- page design for the Conference Paper template.
% A compact two-column US Letter page: XCharter text and maths, Lato for
% display, small-caps section heads, a full-width title block, one plum accent.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{conference}[2026/10/17 Conference Paper]

% ---- Page grid -------------------------------------------------------------
% Narrow outer margins and a 0.33 in gutter, close to the common two-column
% proceedings formats so that page counts carry over.
\RequirePackage[letterpaper, top=0.85in, bottom=0.9in, left=0.72in,
  right=0.72in, columnsep=0.3in, headheight=11pt, headsep=0.18in,
  footskip=0.35in]{geometry}

% ---- Type ------------------------------------------------------------------
% XCharter for text with matching newtxmath, Lato for title, labels and
% figures. Charter is sturdy at 9.5pt, which keeps the dense page legible.
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath}
\RequirePackage{XCharter}
\RequirePackage[xcharter, vvarbb]{newtxmath}
\RequirePackage[scale=0.9, defaultsans]{lato}
\renewcommand*{\familydefault}{\rmdefault}
\linespread{1.06}
\RequirePackage[scaled=0.84]{beramono}
\RequirePackage[protrusion=true, expansion=true, tracking=true, final]{microtype}
\SetTracking{encoding=*, shape=sc}{50}
\frenchspacing
\setlength{\parindent}{1em}
\setlength{\emergencystretch}{1em}

% ---- Accent ----------------------------------------------------------------
% Deep plum for section numbers, caption labels, the best result and the
% highlighted series in plots. Change it here.
\RequirePackage{xcolor}
\definecolor{accent}{HTML}{5A2453}
\colorlet{inkmuted}{black!60}
\newcommand{\cf@label}[1]{{\sffamily\bfseries\scriptsize\color{accent}%
  \textls[100]{\MakeUppercase{#1}}}}

% ---- Headings --------------------------------------------------------------
% Sections: plum Lato numeral and a letterspaced small-caps title.
% Subsections: Lato bold. Paragraphs: italic run-in.
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\normalsize\scshape\raggedright}
  {\textcolor{accent}{\fontshape{n}\sffamily\bfseries\thesection}}{0.7em}{\MakeLowercase}
\titleformat{\subsection}{\sffamily\bfseries\small\raggedright}
  {\thesubsection}{0.6em}{}
\titleformat{\paragraph}[runin]{\normalfont\itshape}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{2.2ex plus .5ex minus .3ex}{1ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus .4ex minus .2ex}{.6ex plus .1ex}
\titlespacing*{\paragraph}{0pt}{1ex plus .3ex}{0.5em}

% ---- Captions and floats ---------------------------------------------------
\RequirePackage[font={footnotesize, sf}, labelfont={bf, color=accent},
  labelsep=period, justification=justified, singlelinecheck=false,
  skip=5pt]{caption}
\setlength{\textfloatsep}{11pt plus 2pt minus 2pt}
\setlength{\dbltextfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\floatsep}{9pt plus 2pt minus 2pt}

% ---- Tables ----------------------------------------------------------------
\RequirePackage{booktabs}
\setlength{\heavyrulewidth}{.7pt}
\setlength{\lightrulewidth}{.35pt}
\newcommand{\best}[1]{\textcolor{accent}{\bfseries #1}}

% ---- Running footer --------------------------------------------------------
% The venue line on the left and the folio on the right, both in Lato.
\RequirePackage{fancyhdr}
\newcommand{\cf@venue}{}
\newcommand{\venue}[1]{\renewcommand{\cf@venue}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\sffamily\scriptsize\color{inkmuted}\cf@venue}
\fancyfoot[R]{\sffamily\scriptsize\bfseries\thepage}
\fancypagestyle{plain}{}

% ---- Title block -----------------------------------------------------------
% \maketitle typesets title, author grid, abstract, keywords and
% the full-width teaser figure given by \teaser across both columns of page one.
\newcommand{\cf@authors}{}
\newcommand{\cf@abstract}{}
\newcommand{\cf@keywords}{}
\newcommand{\cf@ccs}{}
\newcommand{\cf@teaser}{}
\newcommand{\teaser}[1]{\renewcommand{\cf@teaser}{#1}}
\newcommand{\authorgrid}[1]{\renewcommand{\cf@authors}{#1}}
\newcommand{\keywords}[1]{\renewcommand{\cf@keywords}{#1}}
\newcommand{\ccsconcepts}[1]{\renewcommand{\cf@ccs}{#1}}
\RenewDocumentEnvironment{abstract}{+b}{\gdef\cf@abstract{#1}}{}
% One cell of the author grid: name, affiliation, email.
\newcommand{\authorcell}[3]{%
  \begin{tabular}[t]{@{}c@{}}
    {\sffamily\bfseries\normalsize #1}\\[1pt]
    {\footnotesize #2}\\
    {\footnotesize\ttfamily\color{inkmuted}#3}
  \end{tabular}}

\renewcommand{\maketitle}{%%
  \twocolumn[{%
    \centering
    {\sffamily\bfseries\fontsize{19}{23}\selectfont\@title\par}
    \vspace{12pt}
    \cf@authors\par
    \vspace{12pt}
    {\color{accent}\hrule height .6pt}
    \vspace{8pt}
    \begin{minipage}{\textwidth}\small\justifying
      \cf@label{Abstract}\enspace\cf@abstract\par
      \vspace{4pt}
      \ifx\cf@ccs\@empty\else
        \noindent\cf@label{CCS Concepts}\enspace{\footnotesize\cf@ccs}\par
      \fi
      \ifx\cf@keywords\@empty\else
        \noindent\cf@label{Keywords}\enspace{\footnotesize\cf@keywords}\par
      \fi
    \end{minipage}\par
    \vspace{8pt}
    {\color{accent!40}\hrule height .4pt}
    \ifx\cf@teaser\@empty\else\vspace{10pt}\cf@teaser\par\fi
    \vspace{12pt}}]%
  \thispagestyle{fancy}}
\RequirePackage{ragged2e}

% ---- System name -----------------------------------------------------------
% Small caps in serif text; Lato has no small caps, so sans contexts (captions,
% legends, figures) get the plain name instead of a substituted face.
\newcommand{\sysname}{Lantern}
\DeclareRobustCommand{\sys}{\ifnum\pdfstrcmp{\f@family}{\sfdefault}=0
  \sysname\else\textsc{\sysname}\fi}

% ---- Lists -----------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.3em}

\endinput
